; expect: -666010355  -- every atomicrmw operation on 8 bytes (swap, add, sub, and, or, xor, max, min, umax, umin are instructions or an add of the negation; nand is a compare-and-swap loop)
@g = global i64 10
define i32 @test() {
  %acc0 = add i64 0, 0
  %o0 = atomicrmw add ptr @g, i64 5 seq_cst
  %x0 = add i64 %o0, 0
  %m0 = mul i64 %acc0, 31
  %acc1 = add i64 %m0, %x0
  %o1 = atomicrmw sub ptr @g, i64 3 acq_rel
  %x1 = add i64 %o1, 0
  %m1 = mul i64 %acc1, 31
  %acc2 = add i64 %m1, %x1
  %o2 = atomicrmw and ptr @g, i64 10 monotonic
  %x2 = add i64 %o2, 0
  %m2 = mul i64 %acc2, 31
  %acc3 = add i64 %m2, %x2
  %o3 = atomicrmw or ptr @g, i64 3 seq_cst
  %x3 = add i64 %o3, 0
  %m3 = mul i64 %acc3, 31
  %acc4 = add i64 %m3, %x3
  %o4 = atomicrmw xor ptr @g, i64 1 acquire
  %x4 = add i64 %o4, 0
  %m4 = mul i64 %acc4, 31
  %acc5 = add i64 %m4, %x4
  %o5 = atomicrmw max ptr @g, i64 -5 release
  %x5 = add i64 %o5, 0
  %m5 = mul i64 %acc5, 31
  %acc6 = add i64 %m5, %x5
  %o6 = atomicrmw umax ptr @g, i64 -5 seq_cst
  %x6 = add i64 %o6, 0
  %m6 = mul i64 %acc6, 31
  %acc7 = add i64 %m6, %x6
  %o7 = atomicrmw umin ptr @g, i64 7 acq_rel
  %x7 = add i64 %o7, 0
  %m7 = mul i64 %acc7, 31
  %acc8 = add i64 %m7, %x7
  %o8 = atomicrmw xchg ptr @g, i64 100 monotonic
  %x8 = add i64 %o8, 0
  %m8 = mul i64 %acc8, 31
  %acc9 = add i64 %m8, %x8
  %o9 = atomicrmw nand ptr @g, i64 12 seq_cst
  %x9 = add i64 %o9, 0
  %m9 = mul i64 %acc9, 31
  %acc10 = add i64 %m9, %x9
  %o10 = atomicrmw min ptr @g, i64 -1 acquire
  %x10 = add i64 %o10, 0
  %m10 = mul i64 %acc10, 31
  %acc11 = add i64 %m10, %x10
  %o11 = atomicrmw xor ptr @g, i64 0 release
  %x11 = add i64 %o11, 0
  %m11 = mul i64 %acc11, 31
  %acc12 = add i64 %m11, %x11
  %f = load i64, ptr @g
  %fx = add i64 %f, 0
  %fm = mul i64 %acc12, 31
  %fa = add i64 %fm, %fx
  %r = trunc i64 %fa to i32
  ret i32 %r
}
